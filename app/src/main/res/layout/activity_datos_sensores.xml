<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F2E6"
    android:backgroundTint="#F8F2E6"
    tools:context=".DatosSensores">

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="312dp"
        android:layout_height="165dp"
        android:layout_marginTop="44dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="sans-serif-medium"
        android:text="Datos Sensores"
        android:textColor="#DA072940"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView8" />

    <TextView
        android:id="@+id/txt_fecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cargando fecha..."
        android:textColor="#DA072940"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView9" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#123459"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_fecha">

        <ImageView
            android:id="@+id/imagen_temp"
            android:layout_width="93dp"
            android:layout_height="90dp"
            android:src="@drawable/temperatura" />

        <TextView
            android:id="@+id/txt_temp"
            android:layout_width="242dp"
            android:layout_height="29dp"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="8sp"
            android:text="Temperatura = -- C°"
            android:textAlignment="center"
            android:textColor="#F0E0E0"
            android:textSize="23sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="#245997"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <ImageView
            android:id="@+id/imagen_humedad"
            android:layout_width="95dp"
            android:layout_height="97dp"
            android:src="@drawable/humidity" />

        <TextView
            android:id="@+id/txt_humedad"
            android:layout_width="242dp"
            android:layout_height="29dp"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:lineSpacingExtra="8sp"
            android:text="Humedad = --%"
            android:textAlignment="center"
            android:textColor="#F0E0E0"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#6AA3E6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <ImageView
            android:id="@+id/img_ampolleta"
            android:layout_width="95dp"
            android:layout_height="97dp"
            android:layout_weight="1"
            android:src="@drawable/luz1" />

        <ImageView
            android:id="@+id/img_linterna"
            android:layout_width="95dp"
            android:layout_height="95dp"
            android:layout_weight="1"
            app:srcCompat="@drawable/linternaoff"
            app:tint="#092B61" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>